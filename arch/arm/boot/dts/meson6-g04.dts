/dts-v1/;

/include/ "meson6.dtsi"

/ {
	model = "Amlogic AML8726-MX G04 / VB100a Pro";
	compatible = "ddev-io,meson6-g04", "amlogic,meson6";

	cpus {
		enable-method = "ddev-io,meson6-g04-smp";
	};

	aliases {
		serial0 = &uart_A;
		display0 = &framebuffer0;
	};


	/* Supplies are already enabled by the boot loader; these fixed
	 * regulators give the generic DWC2 gadget driver its named rails. */
	usb_vusb_d: regulator-usb-d {
		compatible = "regulator-fixed";
		regulator-name = "vusb_d";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	usb_vusb_a: regulator-usb-a {
		compatible = "regulator-fixed";
		regulator-name = "vusb_a";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-always-on;
	};

	sdio_core_clk: clock@c1104140 {
		compatible = "ddev-io,g04-sdio-gate";
		reg = <0xc1104140 0x4>;
		#clock-cells = <0>;
		clocks = <&clk81>;
	};

	sd_vmmc: regulator-sdcard {
		compatible = "regulator-fixed";
		regulator-name = "sdcard-vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio_sd 31 0>;
		startup-delay-us = <200000>;
	};

	memory {
		device_type = "memory";
		/* Keep the vendor video window outside Linux RAM. */
		reg = <0x80000000 0x04000000>,
		      <0x90d00000 0x0f200000>,
		      <0xa0000000 0x20000000>;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		stdout-path = &uart_A;
		bootargs = "console=ttyAML0,115200n8";

		/* U-Boot/vendor VPU keeps scanning this OSD1 buffer. */
		framebuffer0: framebuffer@84100000 {
			compatible = "simple-framebuffer";
			reg = <0x84100000 0x00800000>;
			width = <1280>;
			height = <800>;
			stride = <5120>;
			format = "a8b8g8r8";
		};
	};

	soc {
		usb2_phy: phy@c1108400 {
			compatible = "amlogic,meson6-usb2-phy";
			reg = <0xc1108400 0x40>,
			      <0xc1104408 0x4>,
			      <0xc1104144 0x4>,
			      <0xc1104148 0x4>;
			reg-names = "phy", "reset", "gclk1", "gclk2";
			#phy-cells = <0>;
		};

		nand@c1108600 {
			compatible = "amlogic,meson6-nand-g04";
			reg = <0xc1108600 0x30>;
			status = "okay";
		};

		usb_otg: usb@c9040000 {
			compatible = "amlogic,meson6-usb", "snps,dwc2";
			reg = <0xc9040000 0x40000>;
			/*
			 * INT_USB_A is level-high in the working Meson6 vendor kernel.
			 * GIC SPI 30 is Linux IRQ 62, which its GIC glue special-cases.
			 */
			interrupts = <0 30 4>;
			clocks = <&clk81>;
			clock-names = "otg";
			phys = <&usb2_phy>;
			phy-names = "usb2-phy";
			vusb_d-supply = <&usb_vusb_d>;
			vusb_a-supply = <&usb_vusb_a>;
			dr_mode = "peripheral";
			g-use-dma;
			status = "okay";
		};

		gpio_sd: gpio@c110806c {
			compatible = "amlogic,meson6-gpio";
			reg = <0xc110806c 0x4>, <0xc1108070 0x4>, <0xc1108074 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <32>;
		};

		mmc@c1108c20 {
			compatible = "amlogic,meson6-sdio", "amlogic,meson-mx-sdio";
			reg = <0xc1108c20 0x20>;
			interrupts = <0 28 1>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&sdio_core_clk>, <&clk81>;
			clock-names = "core", "clkin";
			pinctrl-names = "default";
			pinctrl-0 = <&sdio_b_pins>;

			slot@1 {
				compatible = "mmc-slot";
				reg = <1>;
				bus-width = <4>;
				max-frequency = <25000000>;
				cd-gpios = <&gpio_sd 29 1>;
				vmmc-supply = <&sd_vmmc>;
			};
		};

		g04_ao_pinmux: pinmux@c8100014 {
			compatible = "pinctrl-single";
			reg = <0xc8100014 0x4>;
			pinctrl-single,register-width = <32>;
			pinctrl-single,function-mask = <1>;
			pinctrl-single,bit-per-mux;

			i2c_ao_pins: i2c-ao-pins {
				/* Vendor AO I2C master MUX[6:5], clear alternates. */
				pinctrl-single,bits = <0x0 0x00000060 0x01800066>;
			};
		};

		backlight@c1108654 {
			compatible = "ddev-io,meson6-g04-backlight";
			reg = <0xc1108654 0x8>;
			pinctrl-names = "default";
			pinctrl-0 = <&backlight_pwm_pins>;
		};

		g04_pinmux: pinmux@c11080b0 {
			compatible = "pinctrl-single";
			reg = <0xc11080b0 0x20>;
			pinctrl-single,register-width = <32>;
			pinctrl-single,function-mask = <1>;
			pinctrl-single,bit-per-mux;

			backlight_pwm_pins: backlight-pwm-pins {
				/* Firmware routes PWM_D to GPIOD_1, not LED_BL_PWM. */
				pinctrl-single,bits = <0x04 0 0x10000000>,
						      <0x08 0x00000008 0x00000008>;
			};

			sdio_b_pins: sdio-b-pins {
				/* Vendor SDIO port B uses CARD_0..5, MUX2[15:10]. */
				pinctrl-single,bits = <0x08 0x0000fc00 0x0000fc00>;
			};

			i2c_a_pins: i2c-a-pins {
				/* PERIPHS_PIN_MUX_5[27:26] selects I2C A. */
				pinctrl-single,bits = <0x14 0x0c000000 0x0c000000>;
			};

			gpio_a_touch_pins: gpio-a-touch-pins {
				/* GPIOA_16: MUX0[6], MUX7[4]; GPIOA_23: MUX0[6], MUX7[11]. */
				pinctrl-single,bits = <0x00 0x00000000 0x00000040>,
						      <0x1c 0x00000000 0x00000810>;
			};

			gpio_c_touch_pins: gpio-c-touch-pins {
				/* GPIOC_3: PERIPHS_PIN_MUX_0[13] and _1[8]. */
				pinctrl-single,bits = <0x00 0x00000000 0x00002000>,
						      <0x04 0x00000000 0x00000100>;
			};
		};

		gpio_a: gpio@c1108030 {
			compatible = "amlogic,meson6-gpio";
			reg = <0xc1108030 0x4>,
			      <0xc1108034 0x4>,
			      <0xc1108038 0x4>,
			      <0xc1109880 0x10>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <28>;
			pinctrl-names = "default";
			pinctrl-0 = <&gpio_a_touch_pins>;

			/* Route GPIOA_16 (vendor selector 170) through slot 0. */
			amlogic,irq-slot = <0>;
			amlogic,irq-selector = <170>;
			amlogic,irq-trigger = <3>;
			amlogic,irq-filter = <7>;
		};

		gpio_c: gpio@c1108048 {
			compatible = "amlogic,meson6-gpio";
			reg = <0xc1108048 0x4>,
			      <0xc110804c 0x4>,
			      <0xc1108050 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <15>;
			pinctrl-names = "default";
			pinctrl-0 = <&gpio_c_touch_pins>;
		};
	};
};

&uart_A {
	status = "okay";
};

&i2c_A {
	clock-frequency = <300000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_a_pins>;
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt82x-g04";
		reg = <0x5d>;
		interrupt-parent = <&gic>;
		interrupts = <0 64 1>;
		interrupt-gpios = <&gpio_a 16 0>;
		power-gpios = <&gpio_a 23 0>;
		reset-gpios = <&gpio_c 3 0>;
		/* Same sensor-to-panel calibration as the working vendor kernel. */
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
		touchscreen-inverted-y;
	};
};

&i2c_AO {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_ao_pins>;
	status = "okay";

	battery@34 {
		compatible = "ddev-io,meson6-g04-axp20-battery";
		reg = <0x34>;
	};
};
