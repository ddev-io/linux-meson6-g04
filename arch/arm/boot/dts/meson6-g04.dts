/dts-v1/;

/include/ "meson6.dtsi"

/ {
	model = "Amlogic AML8726-MX G04 / VB100a Pro";
	compatible = "ddev-io,meson6-g04", "amlogic,meson6";

	aliases {
		serial0 = &uart_A;
		display0 = &framebuffer0;
	};


	/* Supplies are already enabled by the boot loader; these fixed
	 * regulators give the generic DWC2 gadget driver its named rails. */
	usb_vusb_d: regulator-usb-d {
		compatible = "regulator-fixed";
		regulator-name = "vusb_d";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	usb_vusb_a: regulator-usb-a {
		compatible = "regulator-fixed";
		regulator-name = "vusb_a";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		regulator-always-on;
	};

	memory {
		device_type = "memory";
		/*
		 * The vendor G04 video/reserved window remains outside Linux RAM.
		 * Recovery does not register the vendor deinterlace device, so its
		 * first MiB at 0x8a300000 is used for the diagnostic ram_console.
		 */
		reg = <0x80000000 0x04000000>,
		      <0x90d00000 0x0f200000>,
		      <0xa0000000 0x20000000>;
	};

	ram_console: ram-console@8a300000 {
		compatible = "google,ram-console";
		reg = <0x8a300000 0x00100000>;
	};

	chosen {
		stdout-path = &uart_A;
		bootargs = "console=ttyAML0,115200n8 earlyprintk";

		/* U-Boot/vendor VPU keeps scanning this OSD1 buffer. */
		framebuffer0: framebuffer@84100000 {
			compatible = "simple-framebuffer";
			reg = <0x84100000 0x00800000>;
			width = <1280>;
			height = <800>;
			stride = <5120>;
			format = "a8b8g8r8";
		};
	};

	soc {
		usb2_phy: phy@c1108400 {
			compatible = "amlogic,meson6-usb2-phy";
			reg = <0xc1108400 0x20>,
			      <0xc1104408 0x4>,
			      <0xc1104144 0x4>,
			      <0xc1104148 0x4>;
			reg-names = "phy", "reset", "gclk1", "gclk2";
			#phy-cells = <0>;
		};

		nand@c1108600 {
			compatible = "amlogic,meson6-nand-g04";
			reg = <0xc1108600 0x30>;
			status = "okay";
		};

		usb_otg: usb@c9040000 {
			compatible = "amlogic,meson6-usb", "snps,dwc2";
			reg = <0xc9040000 0x40000>;
			interrupts = <0 30 1>;
			clocks = <&clk81>;
			clock-names = "otg";
			phys = <&usb2_phy>;
			phy-names = "usb2-phy";
			vusb_d-supply = <&usb_vusb_d>;
			vusb_a-supply = <&usb_vusb_a>;
			dr_mode = "peripheral";
			status = "okay";
		};

		g04_pinmux: pinmux@c11080b0 {
			compatible = "pinctrl-single";
			reg = <0xc11080b0 0x20>;
			pinctrl-single,register-width = <32>;
			pinctrl-single,function-mask = <1>;
			pinctrl-single,bit-per-mux;

			i2c_a_pins: i2c-a-pins {
				/* PERIPHS_PIN_MUX_5[27:26] selects I2C A. */
				pinctrl-single,bits = <0x14 0x0c000000 0x0c000000>;
			};

			gpio_a_touch_pins: gpio-a-touch-pins {
				/* GPIOA_16: MUX0[6], MUX7[4]; GPIOA_23: MUX0[6], MUX7[11]. */
				pinctrl-single,bits = <0x00 0x00000000 0x00000040>,
						      <0x1c 0x00000000 0x00000810>;
			};

			gpio_c_touch_pins: gpio-c-touch-pins {
				/* GPIOC_3: PERIPHS_PIN_MUX_0[13] and _1[8]. */
				pinctrl-single,bits = <0x00 0x00000000 0x00002000>,
						      <0x04 0x00000000 0x00000100>;
			};
		};

		gpio_a: gpio@c1108030 {
			compatible = "amlogic,meson6-gpio";
			reg = <0xc1108030 0x4>,
			      <0xc1108034 0x4>,
			      <0xc1108038 0x4>,
			      <0xc1109880 0x10>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <28>;
			pinctrl-names = "default";
			pinctrl-0 = <&gpio_a_touch_pins>;

			/* Route GPIOA_16 (vendor selector 170) through slot 0. */
			amlogic,irq-slot = <0>;
			amlogic,irq-selector = <170>;
			amlogic,irq-trigger = <3>;
			amlogic,irq-filter = <7>;
		};

		gpio_c: gpio@c1108048 {
			compatible = "amlogic,meson6-gpio";
			reg = <0xc1108048 0x4>,
			      <0xc110804c 0x4>,
			      <0xc1108050 0x4>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <15>;
			pinctrl-names = "default";
			pinctrl-0 = <&gpio_c_touch_pins>;
		};
	};
};

&uart_A {
	status = "okay";
};

&i2c_A {
	clock-frequency = <300000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_a_pins>;
	status = "okay";

	touchscreen@5d {
		compatible = "goodix,gt82x-g04";
		reg = <0x5d>;
		interrupt-parent = <&gic>;
		interrupts = <0 64 1>;
		interrupt-gpios = <&gpio_a 16 0>;
		power-gpios = <&gpio_a 23 0>;
		reset-gpios = <&gpio_c 3 0>;
	};
};
