# Minimal VB100a Pro / Meson6 recovery and NAND bring-up profile.
# This is not the configuration for a complete Android 10 system.
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_NO_HZ=y
CONFIG_HIGH_RES_TIMERS=y
# CONFIG_CGROUPS is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_MODULES is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/content/twrp-2.3.2.3.cpio"
CONFIG_RD_GZIP=y
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
CONFIG_EMBEDDED=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# One ARMv7 platform; keep both Cortex-A9 cores and the existing RAM layout.
CONFIG_ARCH_MULTIPLATFORM=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MESON=y
CONFIG_MACH_MESON6=y
# CONFIG_MACH_MESON8 is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_HIGHMEM=y
CONFIG_HIGHPTE=y
CONFIG_AEABI=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=64
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_MESON6_G04_RAW_BOOT_DTB=y
# CONFIG_KEXEC is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_PCI is not set
# CONFIG_PCIEPORTBUS is not set

# Userspace, root shell and ADB sockets.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
# CONFIG_PACKET is not set
# CONFIG_IPV6 is not set
# CONFIG_NETFILTER is not set
# CONFIG_NETDEVICES is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# CONFIG_CAN is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# Raw MTD remains writable; automatic NFTL/UBI initialisation stays disabled.
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_MESON6_AML=y
# CONFIG_MTD_NAND_MESON6_AML_NFTL is not set
# CONFIG_MTD_UBI is not set
# CONFIG_MTD_SPI_NOR is not set
CONFIG_BLK_DEV_LOOP=y
# CONFIG_SCSI is not set
# CONFIG_ATA is not set

# Board GPIO, touchscreen, UART, pin mux and fixed USB supply rails.
CONFIG_GPIOLIB=y
CONFIG_GPIO_MESON6=y
CONFIG_GPIO_SYSFS=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MESON=y
# CONFIG_SPI is not set
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_SERIO is not set
# CONFIG_HID is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_INPUT_MISC is not set
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GT82X_G04=y
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# U-Boot-initialised LCD and the legacy Android ADB USB gadget.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_BACKLIGHT_LCD_SUPPORT is not set
CONFIG_USB_SUPPORT=y
# CONFIG_USB is not set
CONFIG_USB_GADGET=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_DWC2_PLATFORM=y
CONFIG_PHY_MESON6_USB2=y
CONFIG_USB_G_ANDROID_ADB=y
# CONFIG_USB_GADGET_DEBUG is not set
# CONFIG_USB_DWC2_DEBUG is not set

# Keep the card/filesystem core; this tree still needs a Meson6 SD host port.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# CONFIG_EFI_PARTITION is not set
CONFIG_EXT4_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
# CONFIG_NFS_FS is not set
# CONFIG_NTFS_FS is not set
# CONFIG_SQUASHFS is not set

# Keep boot/NAND diagnostics, omit unrelated drivers and tracing facilities.
CONFIG_ANDROID=y
# Legacy TWRP libcutils/pixelflinger allocates its heap through /dev/ashmem.
CONFIG_STAGING=y
CONFIG_ASHMEM=y
# CONFIG_ANDROID_TIMED_OUTPUT is not set
CONFIG_ANDROID_RAM_CONSOLE=y
CONFIG_ANDROID_RAM_CONSOLE_ENABLE_VERBOSE=y
CONFIG_ANDROID_RAM_CONSOLE_EARLY_INIT=y
CONFIG_ANDROID_RAM_CONSOLE_EARLY_PHYS_ADDR=0x8a300000
CONFIG_ANDROID_RAM_CONSOLE_EARLY_SIZE=0x00100000
CONFIG_WATCHDOG=y
CONFIG_MESON_WATCHDOG=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_FS=y
# DEBUG_FS selects DEBUG_KERNEL; keep the infrastructure without heavy tracing.
CONFIG_DEBUG_KERNEL=y
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_FTRACE is not set
# CONFIG_LOCKUP_DETECTOR is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_EDAC is not set
# CONFIG_IIO is not set
# CONFIG_PWM is not set
# CONFIG_DMADEVICES is not set
# CONFIG_CRYPTO_ANSI_CPRNG is not set
# CONFIG_CRYPTO_HW is not set
